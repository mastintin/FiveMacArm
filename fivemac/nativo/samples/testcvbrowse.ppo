function Main()

    local oWnd, oBr
    local oSlide
    local nPos, oBtn


    oWnd := TWindow():New( 200, 200, 700, 800, "Test CVBrowse (Selection Event)",,,,,,,,, "oWnd", )



    oBr := TCVBrowse():New( 50, 20, 560, 400, oWnd ) ; oBr:bChange := { | o, nIndex | ( oWnd:SetTitle( "Selected Index: " + Str( nIndex ) ) ) } ; oBr:bLDblClick := { | o, nIndex | MsgInfo( "Double Click on Item: " + Str( nIndex ) ) }


    oBr:AddDir( "/Library/Desktop Pictures" )



    oSlide := TSlider():New( 10, 20, 200, 20, oWnd, {| nValue | ( oBr:SetZoom( oSlide:nValue ) ) }, 100,, "oSlide" , "( oBr:SetZoom( oSlide:nValue ) )" )

    oBtn := TButton():New( 10, 300,,, "Open...", oWnd, {| self |(oBr:OpenPanel())},,,,,, "oBtn" ) ; If( .F., oBtn:SetLiquidGlass( .T. ), ) ; If( .F., oBtn:SetGlass( .T. ), )

    oWnd:Activate(,, .F.,, .F.,,, )

return nil
