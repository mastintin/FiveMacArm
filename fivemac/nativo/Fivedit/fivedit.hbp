# FiveEdit Project File
-n
-w
-i../include
-i../../../harbour/include
-L../lib
-L../../../harbour/lib
-lfive
-lfivec
-lz
-lpcre
-lsqlite3
-lscintilla

# Sources
-ldflag=-F./Resources/frameworks
-ldflag=-framework
-ldflag=Cocoa
-ldflag=-framework
-ldflag=WebKit
-ldflag=-framework
-ldflag=IOKit
-ldflag=-framework
-ldflag=ScreenCaptureKit
-ldflag=-framework
-ldflag=Quartz
-ldflag=-framework
-ldflag=CoreImage
-ldflag=-framework
-ldflag=UserNotifications
-ldflag=-framework
-ldflag=ScriptingBridge
-ldflag=-framework
-ldflag=AVKit
-ldflag=-framework
-ldflag=AVFoundation
-ldflag=-framework
-ldflag=CoreMedia
-ldflag=-framework
-ldflag=UniformTypeIdentifiers
-ldflag=-framework
-ldflag=Network
-ldflag=-framework
-ldflag=SystemConfiguration
# Scintilla flags for ObjC
-ldflag=-framework
-ldflag=Scintilla
# RPath flags for LOCAL Resources
-ldflag=-rpath
-ldflag=@executable_path/../Frameworks
-gtstd
-ofivedit
# Helper flags for ObjC
-cflag=-x
-cflag=objective-c
# Sources
fivedit.prg
CreaForm.prg
CreaBuilder.prg
../source/classes/theme_manager.prg

# Headers for Scintilla in C
-cflag=-I../include/scintilla_headers
